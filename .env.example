# Visit counter (Upstash Redis). The Vercel × Upstash integration sets the KV_* pair
# automatically; a store made on upstash.com gives you the UPSTASH_* pair. Either works.
# Without these the site runs fine — the counter just stays hidden.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Sign-in (Auth.js). AUTH_SECRET: any long random string (`npx auth secret`).
# Each provider switches on once its id is set; with none set, sign-in stays hidden.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Optional: any random string; salts the visitor hash used by the rate limit.
VISITOR_SALT=

# Optional: set once a custom domain is live.
NEXT_PUBLIC_SITE_URL=

# Code runner (Judge0). RapidAPI: JUDGE0_URL=https://judge0-ce.p.rapidapi.com and your RapidAPI key.
# Without JUDGE0_URL the editor works but Run is disabled.
JUDGE0_URL=
JUDGE0_KEY=
# Runs per day across the whole site — keep it under your Judge0 plan's daily quota.
RUNNER_DAILY_LIMIT=45
