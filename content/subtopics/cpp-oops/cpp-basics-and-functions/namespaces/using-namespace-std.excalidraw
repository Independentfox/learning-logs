      "link": null,
      "locked": false,
      "text": "Write std:: explicitly. Never put using namespace std; in a header.\nTo shorten one name, use a using-declaration:  using std::cout;",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Write std:: explicitly. Never put using namespace std; in a header.\nTo shorten one name, use a using-declaration:  using std::cout;",
      "autoResize": true,
      "lineHeight": 1.25
    }
