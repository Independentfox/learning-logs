      "isDeleted": false,
      "boundElements": null,
      "updated": 1791471986064,
      "link": null,
      "locked": false,
      "text": "A /* comment ends at the FIRST */ the compiler sees, so the inner */\non line 2 closes the outer comment early.",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A /* comment ends at the FIRST */ the compiler sees, so the inner */\non line 2 closes the outer comment early.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "SF8VFp9YksEesCC5XsvSd",
      "type": "text",
      "x": 44,
      "y": 372,
      "width": 483.76123046875,
      "height": 21.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aA",
      "roundness": null,
      "seed": 49826871,
      "version": 2,
      "versionNonce": 1782542553,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791471986064,
      "link": null,
      "locked": false,
      "text": "Use // instead: every line is its own comment, so nothing can end early.",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Use // instead: every line is its own comment, so nothing can end early.",
      "autoResize": true,
      "lineHeight": 1.25
    },
