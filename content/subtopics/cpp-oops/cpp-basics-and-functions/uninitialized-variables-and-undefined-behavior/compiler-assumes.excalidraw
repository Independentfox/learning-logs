      "seed": 2097375946,
      "version": 2,
      "versionNonce": 727279190,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791473076399,
      "link": null,
      "locked": false,
      "text": "Once UB occurs there are no rules, and \"impossible\" results like this are\nallowed. The fix isn't to reason about what the compiler will do: just\nnever trigger UB.",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Once UB occurs there are no rules, and \"impossible\" results like this are\nallowed. The fix isn't to reason about what the compiler will do: just\nnever trigger UB.",
      "autoResize": true,
      "lineHeight": 1.25
    }
