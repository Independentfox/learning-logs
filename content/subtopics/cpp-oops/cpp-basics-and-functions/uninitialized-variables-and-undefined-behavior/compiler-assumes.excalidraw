    },
    {
      "id": "vM_A5YvfbZMjR6gNGIPr9",
      "type": "text",
      "x": 60,
      "y": 164,
      "width": 252.58447265625,
      "height": 106.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a4",
      "roundness": null,
      "seed": 829333450,
      "version": 2,
      "versionNonce": 1463271766,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791473076399,
      "link": null,
      "locked": false,
      "text": "1. Signed overflow is undefined.\n2. So I may assume it never happens.\n3. Without overflow, x + 1 is always\n    bigger than x.\n4. So replace  x + 1 > x  with  true.",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Signed overflow is undefined.\n2. So I may assume it never happens.\n3. Without overflow, x + 1 is always\n    bigger than x.\n4. So replace  x + 1 > x  with  true.",
      "autoResize": true,
      "lineHeight": 1.25
    },
