      "link": null,
      "locked": false,
      "text": "Inside printDouble, main's variables don't exist as names. Using one is\nthe error \"'value' was not declared in this scope\".",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Inside printDouble, main's variables don't exist as names. Using one is\nthe error \"'value' was not declared in this scope\".",
      "autoResize": true,
      "lineHeight": 1.25
    },
