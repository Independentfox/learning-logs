      "index": "aI",
      "roundness": null,
      "seed": 1796126479,
      "version": 2,
      "versionNonce": 1185546319,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791474264765,
      "link": null,
      "locked": false,
      "text": "Every call to add creates brand-new x, y and sum, and destroys them\nwhen it returns. Nothing is kept between calls.",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Every call to add creates brand-new x, y and sum, and destroys them\nwhen it returns. Nothing is kept between calls.",
      "autoResize": true,
      "lineHeight": 1.25
    },
