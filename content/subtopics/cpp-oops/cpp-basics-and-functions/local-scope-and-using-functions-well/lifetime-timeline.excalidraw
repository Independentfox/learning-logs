      "updated": 1791474264765,
      "link": null,
      "locked": false,
      "text": "Destroyed in reverse order of creation:  sum first, then y, then x.",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Destroyed in reverse order of creation:  sum first, then y, then x.",
