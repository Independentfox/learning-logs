      "lineHeight": 1.25
    },
    {
      "id": "VYWfhuEcIgypt6ZxZoh-r",
      "type": "text",
      "x": 40,
      "y": 450,
      "width": 467.3505859375,
      "height": 42.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
