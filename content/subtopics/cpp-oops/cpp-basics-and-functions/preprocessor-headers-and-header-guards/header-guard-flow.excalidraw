      "boundElements": null,
      "updated": 1791488952445,
      "link": null,
      "locked": false,
      "text": "Guards work per .cpp file. Another .cpp still gets its own copy, so a function\ndefinition in a header can still cause a \"multiple definition\" link error.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Guards work per .cpp file. Another .cpp still gets its own copy, so a function\ndefinition in a header can still cause a \"multiple definition\" link error.",
      "autoResize": true,
      "lineHeight": 1.25
    }
