      "link": null,
      "locked": false,
      "text": "Each arrow points from a target to what it's built from. A target is rebuilt when\nany prerequisite is newer than it. add.h feeds both object files, so both\nare recompiled, and then app is relinked.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Each arrow points from a target to what it's built from. A target is rebuilt when\nany prerequisite is newer than it. add.h feeds both object files, so both\nare recompiled, and then app is relinked.",
      "autoResize": true,
      "lineHeight": 1.25
    },
