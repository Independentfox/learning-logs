      "boundElements": null,
      "updated": 1791473570982,
      "link": null,
      "locked": false,
      "text": "1.  3 * y     →  12\n2.  2 + 12    →  14\n3.  x = 14    →  stores 14 in x\n     (a side effect)",
      "fontSize": 17,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1.  3 * y     →  12\n2.  2 + 12    →  14\n3.  x = 14    →  stores 14 in x\n     (a side effect)",
      "autoResize": true,
      "lineHeight": 1.2
    },
