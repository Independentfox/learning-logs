    {
      "id": "Abqe5GQCSjW56qXLkQcZq",
      "type": "text",
      "x": 60,
      "y": 482,
      "width": 415.669921875,
      "height": 63.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aN",
      "roundness": null,
      "seed": 306761977,
      "version": 2,
      "versionNonce": 2006008697,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791472737936,
      "link": null,
      "locked": false,
      "text": "•  >> skips spaces and newlines, then reads one value\n•  leftover characters stay for the next >>\n•  a failed read sets the variable to 0 and blocks all later reads",
      "fontSize": 17,
      "fontFamily": 5,
